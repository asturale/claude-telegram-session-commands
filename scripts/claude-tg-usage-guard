#!/usr/bin/env python3
"""Usage guard: keep the end of your plan limits free, pause and resume sessions.

  claude-tg-usage-guard              PreToolUse hook (reads the hook JSON on stdin)
  claude-tg-usage-guard resume <id>  run by the timer at the reset: resume a paused session
  claude-tg-usage-guard force <id>   exempt a session and resume it now (/force)

Two caps. Past the soft one (5-hour window at CLAUDE_TG_GUARD_SESSION %, default
80, or the week at CLAUDE_TG_GUARD_WEEK %, default 90) heavy work stops:
subagents and workflows are denied, and each session gets CLAUDE_TG_GUARD_BUDGET
more tool calls (default 30), enough for a question, a server task or a small
fix. Past the budget, or past the hard cap (CLAUDE_TG_GUARD_HARD_SESSION /
_HARD_WEEK, default 95 / 97), every tool call is denied except Telegram replies,
ToolSearch and the task tools. The session tells you where it stands and stops,
so the rest stays free for whatever you need it for.

The first time a session is stopped it is recorded, you get a Telegram message,
and a one-shot user timer (systemd-run, else a detached sleep) runs
`claude-tg-usage-guard resume <session id>` two minutes after the reset. That
types a "continue" message into the session with claude-tg-type. A session you
`/force` is exempt for the rest of its life.

Limits come from api.anthropic.com/api/oauth/usage, cached for 3 minutes in the
same file /usage uses. If they can't be read, nothing is blocked.
Turn the guard off: `touch ~/.local/state/claude-tg/usage-guard/off`.
"""
import json, os, re, shutil, subprocess, sys, time, urllib.error, urllib.request
from datetime import datetime
from pathlib import Path

HOME = Path.home()
BIN = Path(os.path.realpath(__file__)).parent
ENV_FILE = HOME / ".config/claude-tg.env"
TG_DIR = Path(os.environ.get("TELEGRAM_STATE_DIR") or HOME / ".claude/channels/telegram")
USAGE_CACHE = HOME / ".local/state/claude-tg/usage.json"  # shared with claude-tg-usage
STATE = HOME / ".local/state/claude-tg/usage-guard"
PAUSED, FORCED, COUNT = STATE / "paused", STATE / "force", STATE / "count"
CACHE_S = 180  # the endpoint rate-limits hard
RESUME_DELAY = 120  # seconds after the reset
ALLOWED = re.compile(r"^(mcp__plugin_telegram_telegram__.*|ToolSearch|Task(Create|Update|List|Get))$")
HEAVY = re.compile(r"^(Agent|Task|Workflow)$")  # subagents and workflows: refused past the soft cap


def setting(key, default):
    """From the environment, else from ~/.config/claude-tg.env."""
    if os.environ.get(key):
        return os.environ[key]
    try:
        for line in ENV_FILE.read_text().splitlines():
            if line.startswith(key + "="):
                return line.split("=", 1)[1].strip().strip('"') or default
    except OSError:
        pass
    return default


SESSION_MAX = float(setting("CLAUDE_TG_GUARD_SESSION", "80"))
WEEK_MAX = float(setting("CLAUDE_TG_GUARD_WEEK", "90"))
HARD_SESSION = float(setting("CLAUDE_TG_GUARD_HARD_SESSION", "95"))
HARD_WEEK = float(setting("CLAUDE_TG_GUARD_HARD_WEEK", "97"))
BUDGET = int(setting("CLAUDE_TG_GUARD_BUDGET", "30"))  # tool calls per session past the soft cap


def token():
    tok = setting("CLAUDE_CODE_OAUTH_TOKEN", "")
    if tok:
        return tok
    try:
        return json.loads((HOME / ".claude/.credentials.json").read_text())["claudeAiOauth"]["accessToken"]
    except (OSError, ValueError, KeyError):
        return None


def usage(fresh=False):
    try:
        st = json.loads(USAGE_CACHE.read_text())
    except (OSError, ValueError):
        st = {}
    now = time.time()
    # A cache from the future or a far-off retry_at can't be real: don't let an edited
    # file switch the guard off for good.
    fetched = st.get("fetched", 0)
    if not fresh and st.get("data") and 0 <= now - fetched < CACHE_S:
        return st["data"]
    retry_at = st.get("retry_at", 0)
    if (now < retry_at <= now + 3600) or not token():
        return st.get("data")
    req = urllib.request.Request("https://api.anthropic.com/api/oauth/usage", headers={
        "Authorization": f"Bearer {token()}", "anthropic-beta": "oauth-2025-04-20"})
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            st = {"data": json.loads(r.read()), "fetched": now}
    except urllib.error.HTTPError as e:
        if e.code != 429:
            return st.get("data")
        try:
            wait = int(e.headers.get("retry-after") or 600)
        except ValueError:
            wait = 600
        st["retry_at"] = now + min(max(wait, 60), 3600)  # matches the 1-hour cap on reading it back
    except Exception:
        return st.get("data")
    USAGE_CACHE.parent.mkdir(parents=True, exist_ok=True)
    tmp = USAGE_CACHE.with_name(f".usage.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(st))
    tmp.replace(USAGE_CACHE)
    return st.get("data")


def over_limit(data, hard=False):
    """(label, percent, reset datetime or None) of the soft (or hard) cap that is hit, or None."""
    caps = (HARD_SESSION, HARD_WEEK) if hard else (SESSION_MAX, WEEK_MAX)
    for (key, label), cap in zip((("five_hour", "5-hour window"), ("seven_day", "weekly limit")), caps):
        v = (data or {}).get(key) or {}
        if v.get("utilization") is not None and float(v["utilization"]) >= cap:
            try:
                reset = datetime.fromisoformat(v["resets_at"])
            except (KeyError, TypeError, ValueError):
                reset = None
            return label, float(v["utilization"]), reset
    return None


def send(text, sid=""):
    # TELEGRAM_SESSION_ID: tg-send puts that session's "[🔵 2·opus]" label in front, so the
    # message reads as the session's own and a reply to it (/force) goes to that session.
    subprocess.run([str(BIN / "tg-send"), text], capture_output=True, timeout=30,
                   env={**os.environ, "TELEGRAM_SESSION_ID": sid})


def slot(sid):
    """The session's number with the relay, or None."""
    try:
        relay = json.loads((TG_DIR / "relay-state.json").read_text())
        return next((s["slot"] for s in relay["sessions"] if s.get("sessionId") == sid), None)
    except (OSError, ValueError, KeyError, TypeError):
        return None


def name(sid):
    try:
        n = json.loads((TG_DIR / "session-names.json").read_text()).get(sid) or sid[:8]
    except (OSError, ValueError):
        n = sid[:8]
    num = slot(sid)
    return f"{num}·{n}" if num else n


def unit(sid):
    return f"claude-tg-resume-{sid[:8]}"


def schedule(sid, at):
    delay = max(60, int(at - time.time()))
    ok = shutil.which("systemd-run") and subprocess.run(
        ["systemd-run", "--user", "--quiet", f"--unit={unit(sid)}", f"--on-active={delay}s",
         "--timer-property=AccuracySec=30s", str(BIN / "claude-tg-usage-guard"), "resume", sid],
        capture_output=True).returncode == 0
    if not ok:
        subprocess.Popen(["setsid", "sh", "-c", f'sleep {delay}; exec "$0" resume "$1"',
                          str(BIN / "claude-tg-usage-guard"), sid],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def unschedule(sid):
    if shutil.which("systemctl"):
        subprocess.run(["systemctl", "--user", "stop", f"{unit(sid)}.timer"], capture_output=True)


def pause(sid, label, pct, reset, why=""):
    """Record the pause once per session, tell you, and schedule the resume."""
    PAUSED.mkdir(parents=True, exist_ok=True)
    rec = PAUSED / f"{sid}.json"
    if rec.exists():
        return
    at = (reset.timestamp() if reset else time.time() + 5 * 3600) + RESUME_DELAY
    if os.environ.get("CLAUDE_TG_GUARD_RESUME_IN"):  # testing
        at = time.time() + float(os.environ["CLAUDE_TG_GUARD_RESUME_IN"])
    rec.write_text(json.dumps({"session": sid, "limit": label, "percent": pct, "resume_at": at}))
    schedule(sid, at)
    fmt = "%a %H:%M" if at - time.time() > 20 * 3600 else "%H:%M"
    num = slot(sid)
    how = f"/force {num} (or reply /force to this message)" if num else "/force in that session"
    send(f"⏸ Paused session \"{name(sid)}\": {label} at {pct:.0f}%" + (f", {why}" if why else "") + ". "
         f"It continues by itself at {datetime.fromtimestamp(at).strftime(fmt)}. "
         f"{how} lets it go on now.", sid)


def agent(sid):
    try:
        out = subprocess.run(["claude", "agents", "--json"], capture_output=True, text=True, timeout=60).stdout
        return next((a for a in json.loads(out) if a.get("sessionId") == sid), None)
    except Exception:
        return None


def type_into(a, text):
    subprocess.run([str(BIN / "claude-tg-type"), a["id"], text], timeout=120)


def hook():
    try:
        h = json.load(sys.stdin)
    except ValueError:
        return
    sid = h.get("session_id", "")
    if (STATE / "off").exists() or ALLOWED.match(h.get("tool_name", "")) or (FORCED / sid).exists() \
            or (sid and (FORCED / sid[:8]).exists()):  # sid[:8]: from "/new /force …"
        return
    data = usage()
    hit = over_limit(data)
    if not hit:
        return
    label, pct, reset = hit
    if HEAVY.match(h.get("tool_name", "")) and not (PAUSED / f"{sid}.json").exists():
        # Past the soft cap: no subagents or workflows, but the session may go on by itself.
        return deny(f"USAGE GUARD: the {label} is at {pct:.0f}%, so subagents and workflows are off. "
                    f"Do the work yourself with direct tool calls if it is small, else tell the user it is too "
                    f"heavy for now (/force lets it go on).")
    why = ""
    if over_limit(data, hard=True):
        label, pct, reset = over_limit(data, hard=True)
    elif not (PAUSED / f"{sid}.json").exists():
        n = spend(sid, reset)
        if n <= BUDGET:
            return  # small work past the soft cap: chat, server tasks, small fixes
        why = f"it used its {BUDGET} tool calls past the soft cap"
    pause(sid, label, pct, reset, why)
    when = reset.astimezone().strftime("%a %H:%M") if reset else "later"
    deny(f"USAGE GUARD: the {label} is at {pct:.0f}%" + (f" and {why}" if why else "") +
         "; the rest is kept free. Tools are blocked in this session. "
         f"Stop now: send the user one short Telegram reply with where you are and what is left, then end "
         f"your turn. Don't retry other tools. The session gets a 'continue' message after the reset "
         f"({when}); the user can send /force to let it go on now.")


def spend(sid, reset):
    """Count one tool call past the soft cap; the count starts over with each limit window."""
    COUNT.mkdir(parents=True, exist_ok=True)
    f, window = COUNT / f"{sid}.json", str(reset)
    try:
        st = json.loads(f.read_text())
    except (OSError, ValueError):
        st = {}
    n = st.get("n", 0) + 1 if st.get("window") == window else 1
    f.write_text(json.dumps({"window": window, "n": n}))
    return n


def deny(reason):
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                             "permissionDecisionReason": reason}}))


def resume(sid):
    rec = PAUSED / f"{sid}.json"
    if not rec.exists():
        return  # resumed already, or forced
    a = agent(sid)
    rec.unlink()
    if not a:
        send(f"▶ The limit has reset, but session \"{name(sid)}\" no longer runs; nothing resumed.")
        return
    hit = over_limit(usage(fresh=True))
    if hit:
        pause(sid, *hit)  # still over (the weekly cap, say): wait for the next reset
        return
    if a.get("state") != "working":  # unless you got it going already
        type_into(a, "The usage limit has reset (usage guard). Carry on with your task where you left off.")
    send(f"▶ Resumed session \"{name(sid)}\".", sid)


def force(sid, text=""):
    FORCED.mkdir(parents=True, exist_ok=True)
    (FORCED / sid).touch()
    rec = PAUSED / f"{sid}.json"
    if rec.exists():
        rec.unlink()
        unschedule(sid)
        a = agent(sid)
        if a:
            type_into(a, text or "The user sent /force: the usage guard no longer applies to this session. "
                                 "Carry on with your task where you left off.")
            print(f"Usage guard off for \"{name(sid)}\"; resumed.")
            return
    elif text:
        a = agent(sid)
        if a:
            type_into(a, text)
    print(f"Usage guard off for \"{name(sid)}\" for the rest of this session.")


if __name__ == "__main__":
    args = sys.argv[1:]
    if not args:
        hook()
    elif args[0] == "resume" and len(args) == 2:
        resume(args[1])
    elif args[0] == "force" and len(args) >= 2:
        force(args[1], " ".join(args[2:]))
    else:
        sys.exit(__doc__)
