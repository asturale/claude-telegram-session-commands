# Add these lines to ~/.claude/channels/telegram/.env, next to
# TELEGRAM_BOT_TOKEN. Replace /home/you with your home directory: the plugin
# does not expand ~ or $HOME. Leave out any command you don't want.
TELEGRAM_CLEAR_CMD=/home/you/.local/bin/claude-tg-clear
TELEGRAM_BTW_CMD=/home/you/.local/bin/claude-tg-btw
TELEGRAM_COMPACT_CMD=/home/you/.local/bin/claude-tg-compact
TELEGRAM_STOP_CMD=/home/you/.local/bin/claude-tg-stop
TELEGRAM_RELOAD_CMD=/home/you/.local/bin/claude-tg-reload
TELEGRAM_REMEMBER_CMD=/home/you/.local/bin/claude-tg-remember
# Only with the usage guard (scripts/README.md, "Usage guard").
TELEGRAM_FORCE_CMD=/home/you/.local/bin/claude-tg-force
TELEGRAM_USAGE_CMD=/home/you/.local/bin/claude-tg-usage
TELEGRAM_STATUS_CMD=/home/you/.local/bin/claude-tg-status
TELEGRAM_PROGRESS_CMD=/home/you/.local/bin/claude-tg-progress
TELEGRAM_RESUME_CMD=/home/you/.local/bin/claude-tg-resume
TELEGRAM_TASKS_CMD=/home/you/.local/bin/claude-tg-tasks
TELEGRAM_SKILL_CMD=/home/you/.local/bin/claude-tg-skill
TELEGRAM_MODEL_CMD=/home/you/.local/bin/claude-tg-model
TELEGRAM_MODELS=Opus=opus,Sonnet=sonnet,Haiku=haiku
TELEGRAM_MODE_CMD=/home/you/.local/bin/claude-tg-mode
TELEGRAM_MODES=Auto=auto,Accept edits=acceptEdits,Manual=manual
TELEGRAM_EFFORT_CMD=/home/you/.local/bin/claude-tg-effort
TELEGRAM_EFFORTS=low,medium,high,xhigh,max

# Several sessions at once (/new, /close, /sessions).
TELEGRAM_RELAY=1
TELEGRAM_NEW_CMD=/home/you/.local/bin/claude-tg-new
TELEGRAM_CLOSE_CMD=/home/you/.local/bin/claude-tg-close
TELEGRAM_SESSION_INFO_CMD=/home/you/.local/bin/claude-tg-session-info
# Keep open sessions from being retired by the daemon after an idle hour.
TELEGRAM_PIN_CMD=/home/you/.local/bin/claude-tg-pin
# Name sessions after their topic (a short name, once it's clear).
TELEGRAM_AUTONAME_CMD=/home/you/.local/bin/claude-tg-autoname
TELEGRAM_RECAP_CMD=/home/you/.local/bin/claude-tg-recap

# Voice messages: transcribe, then Send/Discard buttons before Claude sees them.
# Needs the CLAUDE_TG_WHISPER_* settings in ~/.config/claude-tg.env.
TELEGRAM_TRANSCRIBE_CMD=/home/you/.local/bin/claude-tg-transcribe
