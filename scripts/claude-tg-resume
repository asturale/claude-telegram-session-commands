#!/usr/bin/env python3
"""/resume (TELEGRAM_RESUME_CMD).
  claude-tg-resume list [n]      lines "<value>\\t<label>": recent conversations
                                 from the n-th on, plus "page-<n>" lines to page through
  claude-tg-resume <session-id>  replace the Telegram session with a fork of it
  claude-tg-resume use-<pid>     switch to an open relay session
  claude-tg-resume name <id>     a short name for an open session, or nothing
                                 while its topic is unclear (claude-tg-autoname)
  claude-tg-resume recap <id>    a few lines on where a session stands (claude-tg-recap)
  claude-tg-resume list cloud[:n]  the claude.ai sessions that aren't archived (needs a
                                 full `claude auth login`, not a long-lived token)
  claude-tg-resume cloud-<id>    copy that claude.ai conversation and continue it in a
                                 new session (claude-tg-session import)

With the relay, the other open sessions come first (● label). Then the
conversations from the project of CLAUDE_TG_CWD (default: your home directory)
that contain a real request; side tasks and open sessions are left out. A name
set with /name wins; otherwise the label is a one-line summary of the topic
(CLAUDE_TG_TITLE_MODEL, run headless and cached), or the first request until
that summary exists. Set CLAUDE_TG_TITLE_MODEL to an empty value to turn the
summaries off. The first page ends with a button to the claude.ai sessions
(☁ cloud session, ● Remote Control session that is connected, ○ one that isn't).
"""
import json, os, re, socket, subprocess, sys, urllib.error, urllib.parse, urllib.request
from concurrent.futures import ThreadPoolExecutor, wait
from datetime import datetime
from pathlib import Path

HOME = Path.home()
here = Path(__file__).resolve().parent
os.environ["PATH"] = f"{here}:{HOME}/.local/bin:" + os.environ.get("PATH", "")
ENV_FILE = HOME / ".config/claude-tg.env"
TG = Path(os.environ.get("TELEGRAM_STATE_DIR") or HOME / ".claude/channels/telegram")
TITLES = HOME / ".local/state/claude-tg/resume-titles.json"
CLOUD_DIR = HOME / ".local/state/claude-tg/cloud"  # copied claude.ai conversations
# Remote Control's automatic session name: "<host>-<adjective>-<noun>".
AUTO_TITLE = re.compile(r"^([A-Za-z0-9.]+)-[a-z]+-[a-z]+$")
CLOUD_TEXT_MAX = 60_000  # characters of a claude.ai conversation in the copy
SHOW = 6
HEAD_BYTES = 400_000
TITLE_WAIT = 20          # seconds; the plugin waits at most 30 s for `list`
LABEL_MAX = 44
NOISE = ("<system-reminder>", "<local-command", "<command-", "This session is being continued", "Caveat:")
# Automatic prompts from claude-tg-btw and claude-tg-remember: not a conversation.
SIDE_TASK = ("Side task (/btw)", "The user asks via Telegram (/remember)")
# Automatic prompts from claude-tg-session: the first real request comes later.
STARTUP = ("Started via /clear from Telegram. Send",
           "Extra session opened via /new in Telegram, next to the existing ones. Send",
           "Extra session opened via /new in Telegram, next to the existing ones. The relay",
           "Model switched to ", "Permission mode switched to ", "Effort switched to ",
           "Session reloaded via /reload", "This earlier conversation was resumed via /resume",
           "A claude.ai session (")


def env_file():
    """KEY=value pairs from ~/.config/claude-tg.env."""
    out = {}
    try:
        for line in ENV_FILE.read_text().splitlines():
            k, eq, v = line.partition("=")
            if eq and k.strip() and not k.lstrip().startswith("#"):
                out[k.strip()] = os.path.expandvars(v.strip().strip("\"'"))
    except OSError:
        pass
    return out


def setting(name, default):
    """From the environment, else from ~/.config/claude-tg.env."""
    if name in os.environ:
        return os.environ[name]
    return env_file().get(name, default)


def load(path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def use(pid):
    """Ask the relay to make session <pid> the active one."""
    with socket.socket(socket.AF_UNIX) as s:
        s.settimeout(5)
        s.connect(str(TG / "relay.sock"))
        s.sendall(json.dumps({"t": "use", "pid": pid}).encode() + b"\n")
        return json.loads(s.makefile().readline() or "{}").get("ok", False)


def user_text(e):
    """Text of a user entry, or None for tool results and the like."""
    if e.get("type") != "user":
        return None
    c = (e.get("message") or {}).get("content")
    if isinstance(c, list):
        c = " ".join(x.get("text", "") for x in c if x.get("type") == "text")
    if not isinstance(c, str) or not c.strip() or c.startswith(NOISE):
        return None
    m = re.search(r"<channel [^>]*>(.*?)</channel>", c, re.S)
    return m.group(1) if m else c


def first_prompt(path):
    """First real user request, or None (side task, nothing but automatic prompts)."""
    with open(path, "rb") as fh:
        head = fh.read(HEAD_BYTES).decode(errors="replace").splitlines()
    for line in head:
        try:
            c = user_text(json.loads(line))
        except ValueError:
            continue
        if c is None or c.startswith(STARTUP + EXTRA_STARTUP):
            continue
        if c.startswith(SIDE_TASK + EXTRA_SIDE_TASK):
            return None
        return re.sub(r"\s+", " ", c).strip()
    return None


def excerpt(path, limit=4000, part=300, recent=False):
    """The user's requests and the Telegram replies, as input for the summary.
    Too long: the beginning and the end, mostly the end when `recent`."""
    parts = []
    with open(path, "rb") as fh:
        for line in fh:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            c = user_text(e)
            if c is not None:
                parts.append("User: " + c)
                continue
            content = (e.get("message") or {}).get("content")
            if e.get("type") == "assistant" and isinstance(content, list):
                for x in content:
                    if x.get("type") == "tool_use" and x.get("name", "").endswith("__reply"):
                        parts.append("Claude: " + str((x.get("input") or {}).get("text", "")))
    parts = [re.sub(r"\s+", " ", p).strip()[:part] for p in parts if p.strip()]
    text = "\n".join(parts)
    if len(text) > limit:  # beginning and end: that's where the topic and the outcome are
        head = limit // 4 if recent else limit * 2 // 3
        text = text[:head] + "\n…\n" + text[-(limit - head):]
    return text


def summarize(path, ask=None, limit=LABEL_MAX, lines=1, timeout=None, text=None):
    """One line about the topic (or up to `lines` lines), from a headless call
    without plugins, hooks, MCP servers, tools or a saved transcript."""
    ask = ask or (f"Give its topic in one short line of at most {LABEL_MAX - 12} characters, in the "
                  "language of the conversation, without quotes, full stop or introduction. "
                  "Only that line.")
    prompt = ("Below is a Claude Code conversation (the user's requests, Claude's replies). "
              + ask + "\n\n" + (text or excerpt(path)))
    env = {k: v for k, v in os.environ.items()
           if not k.startswith(("CLAUDE_CODE_", "TELEGRAM_")) and k not in ("CLAUDECODE", "CLAUDE_PID")}
    env.update(env_file())  # the long-lived token, like the background sessions
    cwd = TITLES.parent / "titles"
    cwd.mkdir(parents=True, exist_ok=True)
    try:
        r = subprocess.run(["claude", "-p", "--model", TITLE_MODEL, "--setting-sources", "",
                            "--settings", '{"enabledPlugins":{"telegram@claude-plugins-official":false}}',
                            "--strict-mcp-config", "--no-session-persistence", "--disable-slash-commands",
                            "--tools", ""], input=prompt, capture_output=True, text=True,
                           timeout=timeout or TITLE_WAIT, cwd=cwd, env=env)
    except (OSError, subprocess.TimeoutExpired):
        return None
    t = (r.stdout or "").strip().splitlines()
    if r.returncode or not t:
        return None
    if lines > 1:
        return "\n".join(l.rstrip() for l in t[:lines] if l.strip())[:limit]
    return t[0].strip(" .\"'*")[:limit]


def titles_for(paths):
    """{session-id: summary}; summarizes new or much grown conversations in parallel."""
    cache = load(TITLES, {})
    todo = [p for p in paths if p.stem not in cache or p.stat().st_size > 1.5 * cache[p.stem].get("size", 0)]
    if todo and TITLE_MODEL:
        pool = ThreadPoolExecutor(len(todo))
        futs = {pool.submit(summarize, p): p for p in todo}
        done, _ = wait(futs, timeout=TITLE_WAIT + 1)
        pool.shutdown(wait=False, cancel_futures=True)
        for f in done:
            p = futs[f]
            try:
                t = f.result()
            except Exception:
                t = None
            if t:
                cache[p.stem] = {"title": t, "size": p.stat().st_size}
        TITLES.parent.mkdir(parents=True, exist_ok=True)
        tmp = TITLES.with_suffix(".tmp")
        tmp.write_text(json.dumps(cache, ensure_ascii=False, indent=0))
        tmp.replace(TITLES)
        # claude -p creates an empty project directory despite --no-session-persistence.
        subprocess.run(["rm", "-rf", str(project_dir(TITLES.parent / "titles"))])
    return {k: v["title"] for k, v in cache.items()}


def project_dir(cwd):
    """Claude Code stores transcripts per project, named after the working
    directory with every non-alphanumeric character replaced by "-"."""
    return HOME / ".claude/projects" / re.sub(r"[^A-Za-z0-9]", "-", str(Path(cwd).resolve()))


def shorten(s, n=LABEL_MAX):
    return s if len(s) <= n else s[:n - 1] + "…"


def prefixes(name):
    """Extra prompt prefixes, separated by |, e.g. from prompts you changed."""
    return tuple(p for p in setting(name, "").split("|") if p)


def cloud_auth():
    """Bearer token and organization of the claude.ai login, or None when that
    login can't read sessions (a long-lived `setup-token` token can't)."""
    try:
        o = json.loads((HOME / ".claude/.credentials.json").read_text())["claudeAiOauth"]
        org = json.loads((HOME / ".claude.json").read_text())["oauthAccount"]["organizationUuid"]
    except (OSError, ValueError, KeyError, TypeError):
        return None
    if "user:sessions:claude_code" not in (o.get("scopes") or []) or not o.get("accessToken"):
        return None
    return o["accessToken"], org


def cloud_get(path, **query):
    auth = cloud_auth()
    if not auth:
        raise RuntimeError("no claude.ai login with session access (run /login)")
    url = "https://api.anthropic.com" + path + ("?" + urllib.parse.urlencode(query) if query else "")
    req = urllib.request.Request(url, headers={
        "Authorization": f"Bearer {auth[0]}", "x-organization-uuid": auth[1],
        "anthropic-version": "2023-06-01", "anthropic-beta": "ccr-byoc-2025-07-29"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        raise RuntimeError("login expired, run /login" if e.code == 401 else f"HTTP {e.code}") from None


def cloud_transcript(sid, limit=CLOUD_TEXT_MAX):
    """The conversation of a claude.ai session as "User:/Claude:" text; too long,
    then the first part and the (more important) end."""
    parts, after = [], None
    for _ in range(50):
        q = {"limit": 1000, **({"after_id": after} if after else {})}
        d = cloud_get(f"/v1/sessions/{sid}/events", **q)
        for e in d.get("data", []):
            if not isinstance(e.get("message"), (dict, type(None))):
                continue  # system notices carry a plain string
            c = user_text(e)
            if c is not None:
                parts.append("User: " + c.strip())
                continue
            content = (e.get("message") or {}).get("content")
            if e.get("type") != "assistant" or not isinstance(content, list):
                continue
            for x in content:
                if x.get("type") == "text" and x.get("text", "").strip():
                    parts.append("Claude: " + x["text"].strip())
                elif x.get("type") == "tool_use":
                    inp = x.get("input") or {}
                    if x.get("name", "").endswith("__reply"):
                        parts.append("Claude: " + str(inp.get("text", "")).strip())
                    else:
                        what = inp.get("description") or inp.get("command") or inp.get("file_path") or ""
                        parts.append(f"[{x.get('name')}: {shorten(str(what).splitlines()[0] if what else '', 120)}]")
        after = d.get("last_id")
        if not d.get("has_more") or not after:
            break
    text = "\n\n".join(parts)
    if len(text) > limit:
        head = limit // 5
        text = text[:head] + "\n\n[… middle of the conversation left out …]\n\n" + text[-(limit - head):]
    return text


def cloud_titles(sessions):
    """{id: summary} for claude.ai sessions that only have an automatic name;
    cached until the session changes, made in parallel like titles_for."""
    cache = load(TITLES, {})
    todo = [s for s in sessions if cache.get(s["id"], {}).get("updated") != s.get("updated_at")]
    if todo and TITLE_MODEL:
        def one(s):
            text = cloud_transcript(s["id"], limit=4000)
            return summarize(None, text=text) if text else "(empty)"
        pool = ThreadPoolExecutor(len(todo))
        futs = {pool.submit(one, s): s for s in todo}
        done, _ = wait(futs, timeout=TITLE_WAIT + 1)
        pool.shutdown(wait=False, cancel_futures=True)
        for f in done:
            try:
                t = f.result()
            except Exception:
                t = None
            if t:
                cache[futs[f]["id"]] = {"title": t, "updated": futs[f].get("updated_at")}
        TITLES.parent.mkdir(parents=True, exist_ok=True)
        tmp = TITLES.with_suffix(".cloud.tmp")
        tmp.write_text(json.dumps(cache, ensure_ascii=False, indent=0))
        tmp.replace(TITLES)
        subprocess.run(["rm", "-rf", str(project_dir(TITLES.parent / "titles"))])
    return {s["id"]: cache[s["id"]]["title"] for s in sessions if s["id"] in cache}


def cloud_list(offset):
    """Rows for the claude.ai submenu: the sessions that aren't archived, newest first."""
    try:
        d = cloud_get("/v1/sessions")
    except Exception as e:
        print(f"Can't read claude.ai sessions: {e}")
        sys.exit(1)
    ss = sorted((s for s in d.get("data", []) if s.get("session_status") != "archived"
                 and s.get("id", "").startswith("session_")),
                key=lambda s: s.get("updated_at", ""), reverse=True)
    # Remote Control sessions that never got a message: nothing to continue.
    cache = load(TITLES, {})
    ss = [s for s in ss if cache.get(s["id"], {}).get("title") != "(empty)"
          or cache[s["id"]].get("updated") != s.get("updated_at")]
    page = ss[offset:offset + SHOW]
    titles = cloud_titles([s for s in page if AUTO_TITLE.match(s.get("title") or "")])
    for s in page:
        when = datetime.fromisoformat(s["updated_at"][:19] + "+00:00").astimezone().strftime("%d %b %H:%M")
        mark = "☁" if s.get("environment_kind") == "anthropic_cloud" else ("●" if s.get("connection_status") == "connected" else "○")
        title = s.get("title") or (s.get("post_turn_summary") or {}).get("status_detail") or s["id"]
        if titles.get(s["id"]):
            topic = re.sub(r"^(Titel|Title|Onderwerp|Topic)\s*:\s*", "", titles[s["id"]])
            title = f"{AUTO_TITLE.match(title).group(1)}: {topic}"
        print(f"cloud-{s['id'][8:]}\t{mark} {when} {shorten(title, LABEL_MAX - 15)}")
    print("page-0\t◂ This computer")
    if offset:
        print(f"page-cloud:{max(offset - SHOW, 0)}\t◂ Newer")
    if len(ss) > offset + SHOW:
        print(f"page-cloud:{offset + SHOW}\tOlder ▸")


if len(sys.argv) < 2:
    sys.exit("usage: claude-tg-resume list [n|cloud[:n]] | <session-id> | cloud-<id> | use-<pid>")

if sys.argv[1].startswith("use-"):
    ok = False
    try:
        ok = use(int(sys.argv[1][4:]))
    except (OSError, ValueError):
        pass
    if not ok:
        subprocess.run(["tg-send", "That session isn't open any more."])
    sys.exit(0 if ok else 1)

TITLE_MODEL = setting("CLAUDE_TG_TITLE_MODEL", "haiku")

if sys.argv[1] == "name":
    # claude-tg-autoname: a short name for an open session, nothing while its topic is unclear.
    f = next((HOME / ".claude/projects").glob(f"*/{sys.argv[2] if len(sys.argv) > 2 else '-'}.jsonl"), None)
    if not f or not TITLE_MODEL:
        sys.exit(0)
    EXTRA_STARTUP = prefixes("CLAUDE_TG_RESUME_SKIP")
    asked = False
    with open(f, "rb") as fh:
        for line in fh:
            try:
                c = user_text(json.loads(line))
            except ValueError:
                continue
            if c is not None and not c.startswith(STARTUP + EXTRA_STARTUP + SIDE_TASK):
                asked = True
                break
    if asked:
        n = summarize(f, "Name this session after its topic or goal: one or two words, at most 16 "
                         "characters, lowercase, in the language of the conversation, without quotes "
                         "or punctuation. If the topic isn't clear yet, answer only -. Only the name.",
                      limit=16)
        subprocess.run(["rm", "-rf", str(project_dir(TITLES.parent / "titles"))])
        if n and n.strip("-"):
            print(n)
    sys.exit(0)

if sys.argv[1] == "recap":
    # claude-tg-recap: where an open session stands, in a few lines.
    f = next((HOME / ".claude/projects").glob(f"*/{sys.argv[2] if len(sys.argv) > 2 else '-'}.jsonl"), None)
    if not f:
        sys.exit(0)
    TITLE_MODEL = setting("CLAUDE_TG_RECAP_MODEL", TITLE_MODEL or "haiku")
    r = summarize(f, "Recap it for the user, who wants to know at a glance where this session stands. "
                     "Write 3 to 5 short lines, each starting with \"• \", in the language of the "
                     "conversation: what it is about, what has been done, and what is still open or "
                     "waiting for the user (say so explicitly if something waits for them). Plain "
                     "text, no markdown, no introduction. Only the lines.",
                  limit=1200, lines=8, timeout=90, text=excerpt(f, limit=12000, part=600, recent=True))
    subprocess.run(["rm", "-rf", str(project_dir(TITLES.parent / "titles"))])
    if r:
        print(r)
    sys.exit(0)

if sys.argv[1].startswith("cloud-"):
    # A claude.ai session: copy its conversation into a file and continue it in
    # an extra session, which reads that file first.
    sid = "session_" + sys.argv[1][6:]
    try:
        s = cloud_get(f"/v1/sessions/{sid}")
        text = cloud_transcript(sid)
    except Exception as e:
        subprocess.run(["tg-send", f"Fetching that claude.ai session failed: {e}"])
        sys.exit(1)
    if not text:
        subprocess.run(["tg-send", "That claude.ai session has no conversation yet."])
        sys.exit(1)
    title = s.get("title") or sid
    auto = AUTO_TITLE.match(title)
    if auto and load(TITLES, {}).get(sid, {}).get("title"):
        title = f"{auto.group(1)}: {load(TITLES, {})[sid]['title']}"
    title = shorten(re.sub(r"[\s\"'`$\\]+", " ", title).strip(), 80)
    os.umask(0o077)  # the copy may hold private data
    CLOUD_DIR.mkdir(parents=True, exist_ok=True)
    CLOUD_DIR.chmod(0o700)
    f = CLOUD_DIR / f"{sid}.md"
    f.write_text(f"# {title}\n\nclaude.ai session {sid} ({s.get('environment_kind', '')}, "
                 f"last updated {s.get('updated_at', '')[:16]})\nhttps://claude.ai/code/{sid}\n\n{text}\n")
    f.chmod(0o600)
    os.execvp("claude-tg-session", ["claude-tg-session", "import", str(f), title])

if sys.argv[1] != "list":
    os.execvp("claude-tg-session", ["claude-tg-session", "resume", sys.argv[1]])

EXTRA_STARTUP = prefixes("CLAUDE_TG_RESUME_SKIP")
EXTRA_SIDE_TASK = prefixes("CLAUDE_TG_RESUME_HIDE")
if len(sys.argv) > 2 and sys.argv[2].startswith("cloud"):
    try:
        cloud_list(max(int(sys.argv[2].partition(":")[2] or 0), 0))
    except ValueError:
        cloud_list(0)
    sys.exit(0)
project = project_dir(setting("CLAUDE_TG_CWD", str(HOME)))
try:
    offset = max(int(sys.argv[2]), 0) if len(sys.argv) > 2 else 0
except ValueError:
    offset = 0
cur = json.loads(subprocess.run(["claude-tg-current"], capture_output=True, text=True,
                                timeout=30).stdout or "{}")
names = load(TG / "session-names.json", {})
relay = load(TG / "relay-state.json", {}) if (TG / "relay.sock").exists() else {}
open_ids = {cur.get("sessionId")}
seen = set()
open_rows = []  # (pid, label, transcript)
for s in sorted(relay.get("sessions", []), key=lambda s: s.get("slot", 0)):
    open_ids.add(s.get("sessionId"))
    f = project / f"{s.get('sessionId')}.jsonl"
    if f.exists():
        seen.add(first_prompt(f))
    if s.get("pid") == relay.get("active") or offset:  # open sessions only on the first page
        continue
    open_rows.append((s["pid"], s.get("label", s["pid"]), f if f.exists() else None))

rows = []  # (transcript, first request)
files = sorted(project.glob("*.jsonl"), key=lambda f: f.stat().st_mtime, reverse=True)
for f in files[:400]:
    if f.stem in open_ids:
        continue
    p = first_prompt(f)
    # Forks (/model, /mode, …) share the first request: show only the newest.
    if not p or p in seen:
        continue
    seen.add(p)
    rows.append((f, p))
    if len(rows) > offset + SHOW:  # one extra: are there older ones?
        break
older = len(rows) > offset + SHOW
rows = rows[offset:offset + SHOW]

titles = titles_for([f for _, _, f in open_rows if f and not names.get(f.stem)] +
                    [f for f, _ in rows if not names.get(f.stem)])

for pid, label, f in open_rows:
    t = f and (names.get(f.stem) or titles.get(f.stem))
    print(f"use-{pid}\t● {shorten(f'{label} {t}') if t else label} (open)")
for f, p in rows:
    when = datetime.fromtimestamp(f.stat().st_mtime).strftime("%d %b %H:%M")
    if names.get(f.stem):
        label = f"{names[f.stem]} · {when}"
    else:
        label = f"{when} {shorten(titles.get(f.stem) or p, LABEL_MAX - 13)}"
    print(f"{f.stem}\t{label}")
if offset:
    print(f"page-{max(offset - SHOW, 0)}\t◂ Newer")
if older:
    print(f"page-{offset + SHOW}\tOlder ▸")
if not offset and cloud_auth():
    print("open-cloud\t☁ claude.ai sessions ▸")
