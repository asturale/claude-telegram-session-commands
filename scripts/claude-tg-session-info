#!/usr/bin/env python3
"""Model and status of one Telegram session, for the relay
(TELEGRAM_SESSION_INFO_CMD). The relay sets TELEGRAM_SESSION_PID; prints JSON
{"model", "status"}.
"""
import json, os, subprocess
from pathlib import Path

here = Path(__file__).resolve().parent
os.environ["PATH"] = f"{here}:{Path.home()}/.local/bin:" + os.environ.get("PATH", "")
cur = json.loads(subprocess.run(["claude-tg-current"], capture_output=True, text=True,
                                timeout=15).stdout or "{}")
print(json.dumps({"model": cur.get("model", ""), "status": cur.get("status", "")}))
