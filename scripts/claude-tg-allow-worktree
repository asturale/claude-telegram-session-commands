#!/usr/bin/env python3
"""Allow EnterWorktree and ExitWorktree without a prompt.

Claude Code shows the permission prompt for these two tools only in the
terminal; it never reaches the channel's permission relay. A Telegram session
that calls one of them waits for an answer nobody can give. This adds both to
permissions.allow in ~/.claude/settings.json (or the file given as argument).
Idempotent; keeps the rest of the file as it is.

Usage: claude-tg-allow-worktree [settings.json]
"""
import json
import os
import sys
import tempfile

RULES = ["EnterWorktree", "ExitWorktree"]

path = sys.argv[1] if len(sys.argv) > 1 else os.path.expanduser("~/.claude/settings.json")

try:
    with open(path) as f:
        raw = f.read()
except FileNotFoundError:
    raw = ""

settings = json.loads(raw) if raw.strip() else {}
if not isinstance(settings, dict):
    sys.exit(f"{path} is not a JSON object, not touching it")
perms = settings.setdefault("permissions", {})
if not isinstance(perms, dict):
    sys.exit(f"permissions in {path} is not an object, not touching it")
allow = perms.setdefault("allow", [])
if not isinstance(allow, list):
    sys.exit(f"permissions.allow in {path} is not a list, not touching it")

added = [r for r in RULES if r not in allow]
if not added:
    print(f"{path}: already allowed ({', '.join(RULES)})")
    sys.exit(0)
allow.extend(added)

os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(path)), prefix=".settings-")
with os.fdopen(fd, "w") as f:
    json.dump(settings, f, indent=2, ensure_ascii=False)
    f.write("\n")
if os.path.exists(path):
    os.chmod(tmp, os.stat(path).st_mode & 0o777)
os.replace(tmp, path)
print(f"{path}: added {', '.join(added)}")
