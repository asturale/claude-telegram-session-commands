#!/usr/bin/env python3
"""MCP servers and trust for a session that works in a git worktree.

  claude-tg-mcp prepare <dir>  get a worktree ready for a background session
                               (claude-tg-session, on /model /mode /effort /reload)
  claude-tg-mcp list           /mcp: buttons as `value<TAB>label` lines: servers
                               that are on (✕) or off (+), then the ones a
                               worktree session lacks
  claude-tg-mcp on:<name>      /mcp tap: turn a server on or off in the running
  claude-tg-mcp off:<name>     session (`/mcp enable|disable`, no restart)
  claude-tg-mcp <name>         /mcp tap: add that server for the session's repo

Claude Code looks up MCP servers added with `claude mcp add` (local scope) per
project in ~/.claude.json, and for a worktree that project is its main
checkout. A session that starts in a worktree therefore lacks the servers of
CLAUDE_TG_CWD. Only the ones in CLAUDE_TG_WORKTREE_MCP (comma-separated,
default none) are added there automatically, so a coding session doesn't get
your mail or home automation unless you ask: /mcp adds another one, which the
session loads after /reload.

`prepare` also marks the worktree as trusted (a background session refuses to
start in a git repo or worktree whose trust prompt was never accepted, and
every new worktree counts), and prints two lines: the --settings JSON that
turns off the servers of the repo's .mcp.json (else a "New MCP server found"
prompt shows in the terminal only), and the names of your servers the session
won't have. It only acts on a real linked worktree in <repo>/.claude/worktrees/
with <repo> inside CLAUDE_TG_CWD, and exits 1 for anything else.
"""
import json, os, re, subprocess, sys, tempfile, time
from pathlib import Path

HOME = Path.home()
BIN = Path(__file__).resolve().parent
CFG = HOME / ".claude.json"


def settings():
    """CLAUDE_TG_* from ~/.config/claude-tg.env, overridden by the environment."""
    out = {}
    try:
        for line in (HOME / ".config/claude-tg.env").read_text().splitlines():
            k, sep, v = line.strip().partition("=")
            if sep and k.startswith("CLAUDE_TG_"):
                out[k] = v.strip().strip("'\"")
    except OSError:
        pass
    out.update({k: v for k, v in os.environ.items() if k.startswith("CLAUDE_TG_")})
    return out


S = settings()
TG_CWD = os.path.realpath(S.get("CLAUDE_TG_CWD") or HOME)
ALLOW = [n.strip() for n in S.get("CLAUDE_TG_WORKTREE_MCP", "").split(",") if n.strip()]


def git(d, *args):
    r = subprocess.run(["git", "-C", d, *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def main_checkout(d):
    """The main checkout of an own worktree d, or None."""
    real = os.path.realpath(d)
    if not os.path.isdir(real) or git(real, "rev-parse", "--show-toplevel") != real:
        return None
    git_dir = git(real, "rev-parse", "--path-format=absolute", "--git-dir")
    common = git(real, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if not common.endswith("/.git") or git_dir == common:
        return None
    main = os.path.realpath(common[:-len("/.git")])
    if not real.startswith(main + "/.claude/worktrees/") or not main.startswith(TG_CWD + "/"):
        return None
    return main


def load():
    with open(CFG) as f:
        return json.load(f)


def save(d):
    # Write through a symlink (dotfiles), keeping the file's mode.
    target = Path(os.path.realpath(CFG))
    fd, tmp = tempfile.mkstemp(dir=str(target.parent), prefix=".claude.json.")
    with os.fdopen(fd, "w") as f:
        json.dump(d, f, indent=2)
    os.chmod(tmp, target.stat().st_mode & 0o777)
    os.replace(tmp, target)


def update(change):
    """Apply change(d) to ~/.claude.json and make sure it sticks. Running
    Claude Code sessions rewrite the file from memory, so a write can be lost:
    re-read right before writing, check afterwards, and retry."""
    for _ in range(5):
        d = load()
        before = json.dumps(d, sort_keys=True)
        result = change(d)
        if json.dumps(d, sort_keys=True) == before:
            return d, result
        save(d)
        time.sleep(0.5)
        if all(change_holds(load(), d, k) for k in KEYS):
            return d, result
    raise SystemExit("~/.claude.json keeps being overwritten; try again")


KEYS = []  # (project, key) pairs the last change set, checked by update()


def change_holds(now, wanted, pk):
    project, key = pk
    want = wanted.get("projects", {}).get(project, {}).get(key)
    return now.get("projects", {}).get(project, {}).get(key) == want


def mine(d):
    return d.get("projects", {}).get(TG_CWD, {}).get("mcpServers", {})


def missing(d, main):
    have = d.get("projects", {}).get(main, {}).get("mcpServers", {})
    return [n for n in mine(d) if n not in have]


def add(d, main, names):
    servers = d.setdefault("projects", {}).setdefault(main, {}).setdefault("mcpServers", {})
    added = [n for n in names if n in mine(d) and n not in servers]
    for n in added:
        servers[n] = mine(d)[n]
    return added


def prepare(wt):
    main = main_checkout(wt)
    if not main:
        sys.exit(1)
    real = os.path.realpath(wt)
    # Trust is passed on, never created: the repo itself must be trusted.
    if not load().get("projects", {}).get(main, {}).get("hasTrustDialogAccepted"):
        print(main)
        sys.exit(3)
    KEYS[:] = [(real, "hasTrustDialogAccepted"), (main, "mcpServers")]

    def change(d):
        d.setdefault("projects", {}).setdefault(real, {})["hasTrustDialogAccepted"] = True
        add(d, main, ALLOW)
    d, _ = update(change)
    try:
        names = list(json.loads((Path(real) / ".mcp.json").read_text()).get("mcpServers", {}))
    except (OSError, ValueError, AttributeError):
        names = []
    print(json.dumps({"disabledMcpjsonServers": names}))
    print(",".join(missing(d, main)))


def session():
    """(id, cwd) of the current Telegram session, or (None, None)."""
    cur = json.loads(subprocess.run([str(BIN / "claude-tg-current")], capture_output=True, text=True).stdout or "{}")
    agents = subprocess.run(["claude", "agents", "--json"], capture_output=True, text=True).stdout
    for a in json.loads(agents or "[]"):
        if cur.get("id") and a.get("id") == cur["id"]:
            return cur["id"], a.get("cwd", "")
    return None, None


def session_main():
    """Main checkout of the worktree the current Telegram session started in."""
    _, cwd = session()
    return main_checkout(cwd) if cwd else None


def listable(name):
    """Without Telegram the session can't be reached to turn it back on. The
    name is typed into the session: no control characters, and `all` is a
    keyword of /mcp that would hit every server."""
    return (name.isprintable() and name == name.strip() and name != "all"
            and name != "telegram" and not name.startswith("plugin:telegram:"))


def slug(name):
    """A server name as a button value: names can hold spaces, buttons can't."""
    return re.sub(r"[^A-Za-z0-9_.:-]", "_", name)[:36]


def servers(d, project):
    """{name: on?} for the project. Connectors and plugin servers are in no
    project's mcpServers, so they are known from the disabled lists.
    shortcut: one that is on in every project isn't listed, add a state file if that matters."""
    projects = d.get("projects", {})
    p = projects.get(project, {})
    off = p.get("disabledMcpServers", [])
    shared = [n for q in projects.values() for n in q.get("disabledMcpServers", [])
              if n.startswith(("claude.ai ", "plugin:"))]
    names = {*p.get("mcpServers", {}), *off, *shared}
    return {n: n not in off for n in sorted(names, key=str.lower) if listable(n)}


def rows(d, project, skip=()):
    """Button lines, servers that are on first."""
    s = {n: on for n, on in servers(d, project).items() if n not in skip}
    return ([f"off:{slug(n)}\t{n} ✕" for n in s if s[n]]
            + [f"on:{slug(n)}\t+ {n}" for n in s if not s[n]])


def toggle(value):
    """Type /mcp enable|disable into the session and check that it took. Only
    a configured name is typed, so a button value never reaches the session."""
    action, _, wanted = value.partition(":")
    sid, cwd = session()
    if not sid:
        tg_send("No Telegram session found.")
        sys.exit(1)
    project = main_checkout(cwd) or cwd
    names = [n for n in servers(load(), project) if slug(n) == wanted]
    if len(names) != 1:
        tg_send(f"{wanted} doesn't match exactly one of your MCP servers.")
        sys.exit(1)
    name = names[0]
    word = "enable" if action == "on" else "disable"
    # Variables of the session the plugin runs in make `claude attach` refuse.
    env = {k: v for k, v in os.environ.items() if k not in
           ("CLAUDE_CODE_CHILD_SESSION", "CLAUDECODE", "CLAUDE_CODE_SESSION_ID", "CLAUDE_PID")}
    if subprocess.run([str(BIN / "claude-tg-type"), sid, f"/mcp {word} {name}"], env=env).returncode:
        tg_send(f"{name}: nothing changed. The session is waiting on a prompt or is not reachable.")
        sys.exit(1)
    for _ in range(10):  # claude-tg-type can't see whether it arrived
        off = load().get("projects", {}).get(project, {}).get("disabledMcpServers", [])
        if (name in off) == (action == "off"):
            tg_send(f"{name} is {action}.")
            return
        time.sleep(1)
    tg_send(f"{name}: not {action} yet. If the session is busy, it follows after this turn.")


def tg_send(text):
    subprocess.run([str(BIN / "tg-send"), text])


if __name__ == "__main__":
    args = sys.argv[1:]
    if args[:1] == ["prepare"] and len(args) == 2:
        prepare(args[1])
    elif args[:1] == ["list"]:
        _, cwd = session()
        main = main_checkout(cwd) if cwd else None
        d = load()
        lacks = missing(d, main) if main else []
        if cwd:
            print("\n".join(rows(d, main or cwd, lacks)))
        for n in lacks:
            print(f"{n}\t+ {n} (then /reload)")
    elif len(args) == 1 and re.match(r"(on|off):", args[0]):
        toggle(args[0])
    elif len(args) == 1:
        main = session_main()
        if not main:
            tg_send("This session doesn't work in a worktree: it already has your MCP servers.")
            sys.exit(1)
        KEYS[:] = [(main, "mcpServers")]
        _, added = update(lambda d: add(d, main, args))
        if added:
            tg_send(f"{args[0]} added for {os.path.basename(main)}. /reload to load it in the session.")
        else:
            tg_send(f"{args[0]} is not one of your MCP servers, or the session already has it.")
    else:
        print(__doc__)
        sys.exit(2)
