# Copy to ~/.config/claude-tg.env (chmod 600). Every line is optional.

# Long-lived token from `claude setup-token`. Without it, sessions use your
# normal login, which can expire while nobody is at the machine.
#CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Where sessions start (default: your home directory).
#CLAUDE_TG_CWD=/home/you
# Model and permission mode for a fresh session (default: opus, auto).
#CLAUDE_TG_MODEL=opus
#CLAUDE_TG_PERMISSION_MODE=auto
# Models for /btw (default: CLAUDE_TG_MODEL) and /remember (default: sonnet).
#CLAUDE_TG_BTW_MODEL=opus
#CLAUDE_TG_REMEMBER_MODEL=sonnet
# Clone of this repository, if the scripts are not symlinked from it.
#CLAUDE_TG_REPO=/home/you/claude-telegram-session-commands
