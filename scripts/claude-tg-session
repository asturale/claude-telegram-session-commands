#!/usr/bin/env bash
# Replace, add or close a Telegram-connected Claude session. Called by the
# plugin through the TELEGRAM_*_CMD variables (see telegram.env.example).
#   claude-tg-session clear [prompt]       fresh session (same model and mode)
#   claude-tg-session model <model>        same conversation (fork) on another model
#   claude-tg-session mode <mode>          same conversation (fork) in another permission mode
#   claude-tg-session effort <level>       same conversation (fork) with another effort level
#   claude-tg-session reload               same conversation (fork), everything reloaded
#   claude-tg-session resume <session-id>  an earlier conversation (fork) takes over
#   claude-tg-session new <model> [prompt] extra session next to the others (relay only)
#   claude-tg-session close                close this session (relay only)
# With the relay (TELEGRAM_RELAY=1), TELEGRAM_SESSION_PID names the session to
# act on; a replacement takes over its number through relay-handover.
# Order: start the new session, wait until its poller is up (bot.pid changes),
# and only then stop the old one. If the start fails, the old one keeps running.
# Do not edit this file while it runs: bash reads scripts incrementally.
. "$(dirname "$(readlink -f "$0")")/claude-tg-common.sh"
cd "$CLAUDE_TG_CWD" || exit 1
LOG="$CLAUDE_TG_STATE/session.log"
STATE="$CLAUDE_TG_STATE/current.json"
SESSIONS="$CLAUDE_TG_STATE/sessions"
exec >>"$LOG" 2>&1
echo "=== $(date -Is) $*"

PIDFILE="$TG_DIR/bot.pid"
HANDOVER="$TG_DIR/relay-handover"
mode="$1"; shift || true

# A plugin update overwrites the patched server.ts, so reapply it first.
claude-tg-patch-plugin || echo "claude-tg-patch-plugin failed (continuing)"

cur=$(claude-tg-current)
get() { python3 -c "import json,sys; print(json.loads(sys.argv[1]).get('$1',''))" "$cur"; }
old_pid=$(get pid); old_id=$(get id); old_session=$(get sessionId)
old_model=$(get model); old_perm=$(get perm); old_effort=$(get effort)
echo "old: pid=$old_pid bg=$old_id session=$old_session model=$old_model perm=$old_perm effort=$old_effort"

model="${old_model:-$CLAUDE_TG_MODEL}"
perm="${old_perm:-$CLAUDE_TG_PERMISSION_MODE}"
effort="$old_effort"
case "$mode" in
  clear)
    extra=()
    prompt="Started via /clear from Telegram. Send the user one short message with the Telegram reply tool saying the fresh session is ready (and on which model)."
    [ -n "$*" ] && prompt="Started via /clear from Telegram, with this request from the user: $*"
    ;;
  model|mode|effort|reload)
    [ "$mode" != reload ] && [ -z "$1" ] && { tg-send "No $mode given."; exit 1; }
    [ -z "$old_session" ] && { tg-send "Switching failed: no running Telegram session found."; exit 1; }
    extra=(--resume "$old_session" --fork-session)
    case "$mode" in
      model)  model="$1";  what="Model switched to $1 via /model" ;;
      mode)   perm="$1";   what="Permission mode switched to $1 via /mode" ;;
      effort) effort="$1"; what="Effort switched to $1 via /effort" ;;
      reload) what="Session reloaded via /reload (MCP servers, settings and plugins reloaded)" ;;
    esac
    prompt="$what in Telegram (conversation resumed). Confirm briefly to the user with the Telegram reply tool and carry on where you were; do not restart again."
    # The fork starts in the working directory. If the old session was in a
    # worktree, the new one has to enter it again.
    wt=$(tail -n 200 "$HOME"/.claude/projects/*/"$old_session".jsonl 2>/dev/null \
         | grep -o '"cwd":"[^"]*/\.claude/worktrees/[^"]*"' | tail -1 | cut -d'"' -f4)
    [ -n "$wt" ] && [ -d "$wt" ] && prompt="$prompt You were working in the worktree $wt: enter it again first with EnterWorktree (path=\"$wt\")."
    ;;
  resume)
    [[ "$1" =~ ^[0-9a-f-]{36}$ ]] || { tg-send "Invalid session id."; exit 1; }
    ls "$HOME"/.claude/projects/*/"$1".jsonl >/dev/null 2>&1 || { tg-send "Session $1 not found."; exit 1; }
    extra=(--resume "$1" --fork-session)
    prompt="This earlier conversation was resumed via /resume in Telegram and is now the Telegram session. Summarise in one short Telegram message (reply tool) what it was about and where we left off, then wait for the user. Do not restart."
    ;;
  new)
    [ -z "$1" ] && { tg-send "No model given."; exit 1; }
    model="$1"; shift
    extra=()
    prompt="Extra session opened via /new in Telegram, next to the existing ones. Send the user one short message with the Telegram reply tool saying this session is ready (and on which model)."
    [ -n "$*" ] && prompt="Extra session opened via /new in Telegram, next to the existing ones, with this request from the user: $*"
    ;;
  close)
    [ -z "$old_id" ] && [ -z "$old_pid" ] && { tg-send "Closing failed: session not found."; exit 1; }
    ;;
  *) echo "usage: $0 clear [prompt] | model <model> | mode <mode> | effort <level> | reload | resume <session-id> | new <model> [prompt] | close"; exit 2 ;;
esac

stop_old() {
  # The conversation is kept; `claude attach <id>` or /resume brings it back.
  if [ -n "$old_id" ]; then
    claude stop "$old_id" && echo "old stopped: $old_id"
    rm -f "$SESSIONS/$old_id.json"
  elif [ -n "$old_pid" ]; then
    # Foreground session from claude-tg-loop.sh: set the quit flag, or it respawns.
    touch "$CLAUDE_TG_QUIT"
    kill -TERM "$old_pid" && echo "old (loop) stopped: $old_pid"
  fi
}
[ "$mode" = close ] && { stop_old; exit 0; }

before=$(cat "$PIDFILE" 2>/dev/null)
srv="${TELEGRAM_SESSION_PID:-$before}"
[ "$mode" != new ] && [ -n "$srv" ] && printf '{"from": %s}\n' "$srv" > "$HANDOVER"
# --channels is variadic: keep it before the other options, or it eats the prompt.
[ -n "$effort" ] && extra+=(--effort "$effort")
if ! out=$(claude --bg --channels "$CHANNEL" --name telegram --model "$model" \
      --permission-mode "$perm" "${extra[@]}" "$prompt" 2>&1); then
  echo "start failed: $out"
  rm -f "$HANDOVER"
  tg-send "Starting the new session failed, the old one is still running. $(tail -2 <<<"$out")"
  exit 1
fi
echo "started: $out"
new_id=$(sed -nE 's/.*backgrounded · ([0-9a-f]+).*/\1/p' <<<"$out" | head -1)

# Wait until the new poller has taken over bot.pid (at most 90 s).
for _ in $(seq 1 45); do
  now=$(cat "$PIDFILE" 2>/dev/null)
  [ -n "$now" ] && [ "$now" != "$before" ] && break
  sleep 2
done
if [ "$(cat "$PIDFILE" 2>/dev/null)" = "$before" ]; then
  rm -f "$HANDOVER"
  tg-send "The new session did not come online within 90 s; the old one stays. Log: $LOG"
  exit 1
fi
printf '{"id": "%s", "model": "%s", "perm": "%s", "effort": "%s"}\n' "$new_id" "$model" "$perm" "$effort" \
  | tee "$SESSIONS/$new_id.json" > "$STATE"

[ "$mode" != new ] && stop_old
exit 0
